{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Interactive radar chart with year selection",
  "width": 650,
  "height": 615,
  "autosize": {"type": "none", "contains": "padding"},
  "signals": [
    {"name": "radius", "update": "width / 2"},
    {
      "name": "YearSelection",
      "value": 2014
    }
  ],
  "data": [
    {
      "name": "table",
      "url": "https://raw.githubusercontent.com/theyeehong/DigitalDividedownUnder/refs/heads/main/data/gbarData.csv",
      "format": {
        "type": "csv",
        "parse": {
          "State": "string",
          "Metric": "string",
          "Score": "number",
          "Year": "number"
        }
      }
    },
    {
      "name": "filtered",
      "source": "table",
      "transform": [
        {"type": "filter", "expr": "datum.Year == YearSelection"},
        {"type": "filter", "expr": "datum.Metric != 'Digital Inclusion Index'"}
      ]
    },
    {
      "name": "keys",
      "source": "filtered",
      "transform": [{"type": "aggregate", "groupby": ["Metric"]}]
    }
  ],
  "scales": [
    {
      "name": "angular",
      "type": "point",
      "range": {"signal": "[-PI, PI]"},
      "padding": 0.5,
      "domain": {"data": "filtered", "field": "Metric"}
    },
    {
      "name": "radial",
      "type": "linear",
      "range": {"signal": "[0, radius]"},
      "zero": true,
      "nice": false,
      "domain": {"data": "filtered", "field": "Score"},
      "domainMin": 0
    },
    {
      "name": "color",
      "type": "ordinal",
      "domain": {"data": "filtered", "field": "State"},
      "range": {"scheme": "category10"}
    }
  ],
  "encode": {"enter": {"x": {"signal": "radius-60"}, "y": {"signal": "radius-10"}}},
  "marks": [
    {
      "type": "group",
      "name": "categories",
      "zindex": 1,
      "from": {
        "facet": {"data": "filtered", "name": "facet", "groupby": ["State"]}
      },
      "marks": [
        {
          "type": "line",
          "name": "category-line",
          "from": {"data": "facet"},
          "encode": {
            "enter": {
              "interpolate": {"value": "linear-closed"},
              "x": {
                "signal": "scale('radial', datum.Score) * cos(scale('angular', datum.Metric))"
              },
              "y": {
                "signal": "scale('radial', datum.Score) * sin(scale('angular', datum.Metric))"
              },
              "stroke": {"scale": "color", "field": "State"},
              "strokeWidth": {"value": 2},
              "fill": {"scale": "color", "field": "State"},
              "fillOpacity": {"value": 0.1}
            }
          }
        },
        {
          "type": "text",
          "name": "value-text",
          "from": {"data": "category-line"},
          "encode": {
            "enter": {
              "x": {"signal": "datum.x"},
              "y": {"signal": "datum.y"},
              "text": {"signal": "datum.datum.Score"},
              "align": {"value": "center"},
              "baseline": {"value": "middle"},
              "fill": {"value": "black"},
              "fontSize": {"value": 12}
            }
          }
        }
      ]
    },
    {
      "type": "rule",
      "name": "radial-grid",
      "from": {"data": "keys"},
      "zindex": 0,
      "encode": {
        "enter": {
          "x": {"value": 0},
          "y": {"value": 0},
          "x2": {"signal": "radius * cos(scale('angular', datum.Metric))"},
          "y2": {"signal": "radius * sin(scale('angular', datum.Metric))"},
          "stroke": {"value": "lightgray"},
          "strokeWidth": {"value": 1}
        }
      }
    },
    {
      "type": "text",
      "name": "key-label",
      "from": {"data": "keys"},
      "zindex": 1,
      "encode": {
        "enter": {
          "x": {"signal": "(radius + 5) * cos(scale('angular', datum.Metric))"},
          "y": {"signal": "(radius + 5) * sin(scale('angular', datum.Metric))"},
          "text": {"field": "Metric"},
          "align": [
            {
              "test": "abs(scale('angular', datum.Metric)) > PI / 2",
              "value": "right"
            },
            {"value": "left"}
          ],
          "baseline": [
            {"test": "scale('angular', datum.Metric) > 0", "value": "top"},
            {"test": "scale('angular', datum.Metric) == 0", "value": "middle"},
            {"value": "bottom"}
          ],
          "fill": {"value": "black"},
          "fontWeight": {"value": "bold"}
        }
      }
    }
  ]
}