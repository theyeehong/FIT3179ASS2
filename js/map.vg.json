{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Australian Digital Inclusion Map",
  "width": 450,
  "height": 400,
  "projection": { "type": "equirectangular" },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/theyeehong/FIT3179ASS2/refs/heads/main/js/ne_10m.json",
        "format": {
          "type": "topojson",
          "feature": "ne_10m_admin_1_states_provinces"
        }
      },
      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/theyeehong/FIT3179ASS2/refs/heads/main/data/dgiByStates.csv"
            },
            "key": "State",
            "fields": ["Digital Inclusion Index"]
          }
        },
        {
          "filter": "datum['Digital Inclusion Index'] != null"
        }
      ],
      "mark": { "type": "geoshape", "stroke": "black", "strokeWidth": 0.5 },
      "encoding": {
        "color": {
          "field": "Digital Inclusion Index",
          "type": "quantitative",
          "scale": { "type": "linear" },
          "legend": { "gradientLength": 350, "gradientThickness": 15 }
        },
        "tooltip": [
          { "field": "properties.name", "title": "State" },
          { "field": "Digital Inclusion Index", "type": "quantitative" }
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/theyeehong/FIT3179ASS2/refs/heads/main/js/ne_10m.json",
        "format": {
          "type": "topojson",
          "feature": "ne_10m_admin_1_states_provinces"
        }
      },
      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/theyeehong/FIT3179ASS2/refs/heads/main/data/dgiByStates.csv"
            },
            "key": "State",
            "fields": ["Digital Inclusion Index"]
          }
        },
        {
          "filter": "datum['Digital Inclusion Index'] != null"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "black"
      },
      "encoding": {
        "text": { "field": "properties.name", "type": "nominal" },
        "longitude": { "field": "properties.longitude" },
        "latitude": { "field": "properties.latitude" }
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/theyeehong/FIT3179ASS2/refs/heads/main/js/ne_10m.json",
        "format": {
          "type": "topojson",
          "feature": "ne_10m_graticules_10"
        }
      },
      "mark": { "type": "geoshape", "stroke": "grey"},
      "encoding": {}
    }
  ]
}
