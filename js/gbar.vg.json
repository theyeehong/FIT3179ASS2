{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 450,
  "height": 250,
  "params": [
    {
      "name": "YearSelection",
      "value": 2014
    }
  ],
  "data": {
    "url": "https://raw.githubusercontent.com/theyeehong/DigitalDividedownUnder/refs/heads/main/data/gbarData.csv"
  },
  "transform": [{ "filter": "datum.Year == YearSelection" }],
  "layer": [
    {
      "selection": {
        "StateHighlight": {
          "type": "multi",
          "fields": ["State"],
          "bind": "legend"
        }
      },
      "mark": "bar",
      "encoding": {
        "x": {
          "field": "Metric",
          "axis": { "labelAngle": 0, "titleFontWeight": "normal" }
        },
        "y": {
          "field": "Score",
          "type": "quantitative",
          "scale": { "domain": [0, 100] },
          "axis": {
            "titleFontWeight": "normal"
          }
        },
        "xOffset": { "field": "State" },
        "color": { "field": "State" },
        "tooltip": [
          { "field": "State", "title": "State" },
          { "field": "Metric", "title": "Metric" },
          { "field": "Score", "title": "Score", "format": ".1f" },
          { "field": "Year", "title": "Year" }
        ],
        "opacity": {
          "condition": { "selection": "StateHighlight", "value": 1 },
          "value": 0.1
        }
      }
    },
    {
      "transform": [{ "filter": "datum.State == 'Victoria'" }],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": 5,
        "dx": 15,
        "fontSize": 12,
        "angle": -90
      },
      "encoding": {
        "x": { "field": "Metric" },
        "y": { "field": "Score", "type": "quantitative" },
        "xOffset": { "field": "State" },
        "text": { "field": "Score" },
        "color": { "value": "black" },
        "opacity": {
          "condition": { "selection": "StateHighlight", "value": 1 },
          "value": 0.1
        }
      }
    }
  ]
}
