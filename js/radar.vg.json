{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Interactive radar chart with outer polygon",
  "width": 655,
  "height": 355,
  "autosize": { "type": "none", "contains": "padding" },
  "signals": [
    { "name": "radius", "update": "width / 2" },
    {
      "name": "YearSelection",
      "value": 2014
    }
  ],
  "data": [
    {
      "name": "table",
      "url": "https://raw.githubusercontent.com/theyeehong/DigitalDividedownUnder/refs/heads/main/data/radar.csv",
      "format": {
        "type": "csv",
        "parse": {
          "State": "string",
          "Metric": "string",
          "Score": "number",
          "Year": "number"
        }
      }
    },
    {
      "name": "filtered",
      "source": "table",
      "transform": [
        { "type": "filter", "expr": "datum.Year == YearSelection" },
        {
          "type": "filter",
          "expr": "datum.Metric != 'Digital Inclusion Index'"
        }
      ]
    },
    {
      "name": "keys",
      "source": "filtered",
      "transform": [{ "type": "aggregate", "groupby": ["Metric"] }]
    }
  ],
  "scales": [
    {
      "name": "angular",
      "type": "point",
      "range": { "signal": "[-PI, PI]" },
      "padding": 0.5,
      "domain": { "data": "filtered", "field": "Metric" }
    },
    {
      "name": "radial",
      "type": "linear",
      "range": { "signal": "[0, radius]" },
      "zero": true,
      "nice": false,
      "domain": { "data": "filtered", "field": "Score" },
      "domainMin": 0
    },
    {
      "name": "color",
      "type": "ordinal",
      "domain": { "data": "filtered", "field": "State" },
      "range": { "scheme": "category10" }
    }
  ],
  "encode": {
    "enter": { "x": { "signal": "radius-60" }, "y": { "signal": "radius-150" } }
  },
  "marks": [
    {
      "type": "group",
      "name": "categories",
      "zindex": 1,
      "from": {
        "facet": { "data": "filtered", "name": "facet", "groupby": ["State"] }
      },
      "marks": [
        {
          "type": "line",
          "name": "category-line",
          "from": { "data": "facet" },
          "encode": {
            "enter": {
              "interpolate": { "value": "linear-closed" },
              "x": {
                "signal": "0.5 * scale('radial', datum.Score) * cos(scale('angular', datum.Metric))"
              },
              "y": {
                "signal": "0.5 * scale('radial', datum.Score) * sin(scale('angular', datum.Metric))"
              },
              "stroke": { "scale": "color", "field": "State" },
              "strokeWidth": { "value": 2 },
              "fill": { "scale": "color", "field": "State" },
              "fillOpacity": { "value": 0.1 }
            }
          }
        },
        {
          "type": "text",
          "name": "value-text",
          "from": { "data": "category-line" },
          "encode": {
            "enter": {
              "x": {
                "signal": "1.05 * 0.5 * scale('radial', datum.datum.Score) * cos(scale('angular', datum.datum.Metric))"
              },
              "y": {
                "signal": "1.05 * 0.5 * scale('radial', datum.datum.Score) * sin(scale('angular', datum.datum.Metric))"
              },
              "text": { "signal": "datum.datum.Score" },
              "align": { "value": "center" },
              "baseline": { "value": "middle" },
              "fill": { "value": "black" },
              "fontSize": { "value": 14 }
            }
          }
        }
      ]
    },
    {
      "type": "rule",
      "name": "radial-grid",
      "from": { "data": "keys" },
      "zindex": 0,
      "encode": {
        "enter": {
          "x": { "value": 0 },
          "y": { "value": 0 },
          "x2": {
            "signal": "0.5 * radius * cos(scale('angular', datum.Metric))"
          },
          "y2": {
            "signal": "0.5 * radius * sin(scale('angular', datum.Metric))"
          },
          "stroke": { "value": "lightgray" },
          "strokeWidth": { "value": 1 }
        }
      }
    },
    {
      "type": "text",
      "name": "key-label",
      "from": { "data": "keys" },
      "zindex": 1,
      "encode": {
        "enter": {
          "x": {
            "signal": "0.55 * (radius -10) * cos(scale('angular', datum.Metric))"
          },
          "y": {
            "signal": "0.55 * (radius + 5) * sin(scale('angular', datum.Metric))"
          },
          "text": { "field": "Metric" },
          "align": [
            {
              "test": "abs(scale('angular', datum.Metric)) > PI / 2",
              "value": "right"
            },
            { "value": "left" }
          ],
          "baseline": [
            { "test": "scale('angular', datum.Metric) > 0", "value": "top" },
            {
              "test": "scale('angular', datum.Metric) == 0",
              "value": "middle"
            },
            { "value": "bottom" }
          ],
          "fill": { "value": "black" },
          "fontWeight": { "value": "bold" },
          "fontSize": { "value": 16 }
        }
      }
    },
    {
      "type": "line",
      "name": "outer-line",
      "from": { "data": "radial-grid" },
      "encode": {
        "enter": {
          "interpolate": { "value": "linear-closed" },
          "x": { "field": "x2" },
          "y": { "field": "y2" },
          "stroke": { "value": "lightgray" },
          "strokeWidth": { "value": 1 }
        }
      }
    }
  ]
}