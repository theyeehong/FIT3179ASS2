{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "background": "#f5f5f5",
  "width": 800,
  "height": 500,
  "params": [
    {
      "name": "YearSelection",
      "value": 2014
    }
  ],
  "data": {
    "url": "https://raw.githubusercontent.com/theyeehong/DigitalDividedownUnder/refs/heads/main/data/heatmapData.csv"
  },
  "transform": [{ "filter": "datum.Year == YearSelection" }],
  "layer": [
    {
      "mark": "rect",
      "encoding": {
        "y": {
          "field": "Metric",
          "type": "nominal",
          "axis": {
            "labelFontSize": 16,
            "titleFontSize": 18,
            "labelAngle": -90,
            "titleFontWeight": "normal"
          }
        },
        "x": {
          "field": "Income Quintiles",
          "type": "nominal",
          "axis": {
            "labelFontSize": 16,
            "titleFontSize": 18,
            "labelAngle": 0,
            "titleFontWeight": "normal"
          }
        },
        "color": {
          "field": "Score",
          "type": "quantitative",
          "scale": { "domain": [25, 85], "scheme": "blues" },
          "legend": {
            "gradientLength": 485,
            "gradientThickness": 15,
            "labelFontSize": 14,
            "titleFontSize": 16
          }
        },
        "tooltip": [
          { "field": "Year", "title": "Year" },
          { "field": "Metric", "type": "nominal" },
          { "field": "Income Quintiles", "type": "nominal" },
          { "field": "Score", "type": "quantitative" }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "baseline": "middle",
        "fontSize": 16
      },
      "encoding": {
        "y": { "field": "Metric", "type": "nominal" },
        "x": { "field": "Income Quintiles", "type": "nominal" },
        "text": { "field": "Score", "type": "quantitative" },
        "color": {
          "condition": {
            "test": "datum.Score > 55",
            "value": "white"
          },
          "value": "black"
        }
      }
    }
  ],
  "config": {
    "font": "Futura",
    "title": { "font": "Futura" },
    "axis": {
      "grid": true,
      "tickBand": "extent",
      "labelFont": "Futura",
      "titleFont": "Futura"
    },
    "legend": {
      "labelFont": "Futura",
      "titleFont": "Futura"
    },
    "view": { "stroke": "transparent" }
  }
}
