{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#f5f5f5",
  "width": 900,
  "height": 550,
  "config": {
    "font": "Futura",
    "title": {"font": "Futura"},
    "axis": {"labelFont": "Futura", "titleFont": "Futura"},
    "legend": {"labelFont": "Futura", "titleFont": "Futura"},
    "view": {"stroke": "transparent"}
  },
  "params": [
    {
      "name": "YearSelection",
      "value": 2014
    }
  ],
  "projection": { "type": "equirectangular" },
  "layer": [
        {
      "data": {
        "url": "https://raw.githubusercontent.com/theyeehong/FIT3179ASS2/refs/heads/main/js/ne_10m.json",
        "format": {
          "type": "topojson",
          "feature": "ne_10m_graticules_10"
        }
      },
      "mark": { "type": "geoshape", "stroke": "grey" },
      "encoding": {}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/theyeehong/FIT3179ASS2/refs/heads/main/js/ne_10m.json",
        "format": {
          "type": "topojson",
          "feature": "ne_10m_admin_1_states_provinces"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ddd",
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "tooltip": { "field": "properties.name", "title": "State" }
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/theyeehong/DigitalDividedownUnder/refs/heads/main/data/mapData.csv"
      },
      "transform": [
        {
          "lookup": "State",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/theyeehong/FIT3179ASS2/refs/heads/main/js/ne_10m.json",
              "format": {
                "type": "topojson",
                "feature": "ne_10m_admin_1_states_provinces"
              }
            },
            "key": "properties.name"
          },
          "as": "geo"
        },
        { "filter": "datum.Year == YearSelection" }
      ],
      "mark": { "type": "geoshape", "stroke": "#fff", "strokeWidth": 0.5 },
      "encoding": {
        "shape": { "field": "geo", "type": "geojson" },
        "color": {
          "field": "Digital Inclusion Index",
          "type": "quantitative",
          "scale": { "domain": [46, 70], "scheme": "blues" },
          "legend": {
            "gradientLength": 505,
            "gradientThickness": 15,
            "labelFontSize": 14,
            "titleFontSize": 16,
            "title": "DGI"
          }
        },
        "tooltip": [
          { "field": "State", "title": "State" },
          { "field": "Digital Inclusion Index", "title": "Index" },
          { "field": "Year", "title": "Year" }
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/theyeehong/FIT3179ASS2/refs/heads/main/js/ne_10m.json",
        "format": {
          "type": "topojson",
          "feature": "ne_10m_admin_1_states_provinces"
        }
      },
      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/theyeehong/DigitalDividedownUnder/refs/heads/main/data/mapData.csv"
            },
            "key": "State",
            "fields": ["Digital Inclusion Index"]
          }
        },
        { "filter": "datum['Digital Inclusion Index'] != null" }
      ],
      "mark": {
        "type": "text",
        "fontSize": 15,
        "color": "black"
      },
      "encoding": {
        "text": { "field": "properties.name", "type": "nominal" },
        "longitude": { "field": "properties.longitude" },
        "latitude": { "field": "properties.latitude" }
      }
    }
  ]
}
